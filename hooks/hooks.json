{
  "description": "Model preflight: checks model and effort fit, offers an independent agent, or pauses for a session switch",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/scripts/Add-ModelPreflightContext.ps1\" || sh \"${CLAUDE_PLUGIN_ROOT}/scripts/add-model-preflight-context.sh\"",
            "statusMessage": "Checking model fit"
          }
        ]
      }
    ]
  }
}
